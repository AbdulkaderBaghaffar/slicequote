# .env.example 
DB_NAME=slicequote
DB_URL=jdbc:postgresql://db:5432/slicequote
DB_USER=postgres
DB_PASSWORD=changeme
JWT_SECRET=replace-me-with-a-32-byte-minimum-secret
STORAGE_ROOT=/app/uploads
# Comma-separated browser origins allowed to call the API.
# Local development and local production preview:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
# Production behind nginx: add your public origin, e.g.
# CORS_ALLOWED_ORIGINS=https://quotes.example.com
